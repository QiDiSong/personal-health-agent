# Run: python scripts/init_env.py (writes random local secrets without printing them).
# Tokens must be at least 32 characters. Never commit .env.
HEALTH_API_TOKEN=
HEALTH_MCP_TOKEN=
HEALTH_DATABASE_URL=sqlite:///./health.db
HEALTH_TIMEZONE=Asia/Shanghai
HEALTH_API_URL=http://127.0.0.1:8000
# Used by Docker Compose; generate a strong URL-safe password.
POSTGRES_PASSWORD=
# Optional external HTTPS MCP origin when running behind a reverse proxy:
# HEALTH_MCP_PUBLIC_ORIGIN=https://health.example.com
